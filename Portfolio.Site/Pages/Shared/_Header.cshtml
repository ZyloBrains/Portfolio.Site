@inject Portfolio.Site.Data.ApplicationDbContext _db

<header class="header header-6">
    <div class="navbar-area">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12">
                    <nav class="navbar navbar-expand-lg">
                        <a class="navbar-brand" href="index.html">
                            <img src="/img/logo/logo.png" alt="Logo" />
                        </a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent6" aria-controls="navbarSupportedContent6" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="toggler-icon"></span>
                            <span class="toggler-icon"></span>
                            <span class="toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse sub-menu-bar" id="navbarSupportedContent6">
                            @{
                                // load enabled sections from the database and order them
                                var sections = _db.Sections
                                    .Where(s => s.Enabled)
                                    .OrderBy(s => s.Order)
                                    .Select (s => new
                                    {
                                        s.Id,
                                        s.Title
                                    })
                                    .ToList();

                                // simple slug generator for anchor targets
                                string Slug(string title, int id)
                                {
                                    if (string.IsNullOrWhiteSpace(title)) return $"section-{id}";
                                    var s = System.Text.RegularExpressions.Regex.Replace(title.ToLowerInvariant(), @"[^a-z0-9\s-]", "");
                                    s = System.Text.RegularExpressions.Regex.Replace(s, @"\s+", "-").Trim('-');
                                    return string.IsNullOrEmpty(s) ? $"section-{id}" : s;
                                }
                            }

                            <ul id="nav6" class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="page-scroll active" href="#home">Home</a>
                                </li>

                                @foreach (var sec in sections)
                                {
                                    <li class="nav-item">
                                        <a class="page-scroll" href="#@Slug(sec.Title, sec.Id)">@sec.Title</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</header>
